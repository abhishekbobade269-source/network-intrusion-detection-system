# Copy to .env and adjust. All variables are prefixed NIDS_ (see nids/config.py).
# Never commit a real .env — it's gitignored.

NIDS_ENVIRONMENT=development
NIDS_LOG_LEVEL=INFO
NIDS_LOG_JSON=false

NIDS_API_HOST=0.0.0.0
NIDS_API_PORT=8000
NIDS_API_CORS_ORIGINS=["http://localhost:5173"]
# Required to call any /system/capture/* or acknowledge endpoint once set.
NIDS_API_KEY=

# docker-compose's postgres service; swap for your managed DB in production.
NIDS_DATABASE_URL=postgresql+asyncpg://nids:nids@localhost:5432/nids
NIDS_DATABASE_ECHO=false

# Interface to sniff (e.g. eth0, en0, "Wi-Fi"). Leave unset to use
# replay-only mode (pcap files / offline datasets) — no root/Npcap needed.
NIDS_CAPTURE_INTERFACE=
NIDS_CAPTURE_BPF_FILTER=ip or ip6
NIDS_FLOW_IDLE_TIMEOUT_S=15
NIDS_FLOW_ACTIVE_TIMEOUT_S=120

NIDS_ML_ENABLED=true
NIDS_ML_MODEL_PATH=models/anomaly_model.joblib
NIDS_ML_ANOMALY_THRESHOLD=0.5

# Optional: POST a JSON payload here for every alert at/above this severity.
NIDS_ALERT_WEBHOOK_URL=
NIDS_ALERT_MIN_SEVERITY=low
